# ─── Obligatoire ──────────────────────────────────────────────
# Token du bot : https://discord.com/developers/applications → ton appli → Bot → Reset Token
TOKEN=colle_ton_token_ici

# Ton ID Discord (clic droit sur ton profil → Copier l'identifiant, mode développeur activé).
# Ces personnes ont TOUS les droits sur le bot (grade « buyer »). Plusieurs IDs : séparés par des virgules.
OWNER_IDS=123456789012345678

# ─── Facultatif ───────────────────────────────────────────────
# Nom affiché dans les embeds
BOT_NAME=Gakuran
# Couleur par défaut des embeds (hexadécimal)
EMBED_COLOR=#8b5cf6
# Fichier de cookies YouTube (format Netscape) si YouTube bloque la lecture. Laisse vide sinon.
YT_COOKIES=

# Clé API Klipy (gratuite) pour les GIF anime sur les sanctions (domain expansion, Gojo, Sukuna…).
# Crée-la sur https://partner.klipy.com → API Keys. Sans clé, le bot utilise des GIF anime d'API publiques.
KLIPY_API_KEY=
